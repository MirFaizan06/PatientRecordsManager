{
  "appId": "com.mirfaizan.patientrecordsmanager",
  "productName": "Patient Records Manager",
  "copyright": "© 2026 Mir Faizan",
  "directories": {
    "output": "dist",
    "buildResources": "resources"
  },
  "files": [
    "out/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/face-models",
      "to": "face-models"
    }
  ],
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
